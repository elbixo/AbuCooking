# Copia este archivo a .env.local y rellénalo con los datos de tu proyecto de Supabase
# (Project Settings → API / Data API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-o-publishable

# Solo para el panel /admin (se usa en el servidor, nunca en el navegador).
# Supabase → Project Settings → API Keys → "Secret key" (sb_secret_...) o la legacy "service_role".
SUPABASE_SERVICE_ROLE_KEY=tu-clave-secreta
